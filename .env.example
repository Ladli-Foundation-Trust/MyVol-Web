# Copy to .env (or set these in the hosting dashboard). All are read at RUNTIME on the
# server, so changing one needs a restart, not a rebuild.

# The public address of this site. Used in share links, Open Graph tags and the sitemap.
SITE_URL=https://myvol.org

# The MyVol API (myvolapp_backend). The site's server calls GET /previews/... to build
# link previews; browsers never call it directly, so no CORS setup is needed.
API_URL=https://api.myvol.org/api/v1

# Android App Links: SHA-256 fingerprints of every certificate the APK is signed with,
# comma-separated (uppercase hex with colons, as `keytool -list -v` prints them).
# The default below is the key the app is signed with TODAY: React Native's shared debug
# key. Replace it with your release key's fingerprint before the Play Store, and add the
# "App signing key certificate" from Play Console > Setup > App integrity once you upload.
ANDROID_CERT_SHA256=FA:C6:17:45:DC:09:03:78:6F:B9:ED:E6:2A:96:2B:39:9F:73:48:F0:BB:6F:89:9B:83:32:66:75:91:03:3B:9C

# Where "Get the app" points: the APK link for now, the Play Store page later.
# Empty = the button says "Coming soon".
ANDROID_DOWNLOAD_URL=

# iOS Universal Links (apple-app-site-association). Your Apple Developer Team ID; empty =
# the file returns 404 (there is no iOS app yet).
APPLE_TEAM_ID=

# Shown on Privacy, Terms, Delete account and the footer.
CONTACT_EMAIL=support@myvol.org
